generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                 @id @default(cuid())
  name                String?
  email               String?                @unique
  pendingEmail        String?
  emailVerified       DateTime?
  passwordHash        String?
  image               String?
  /// Valid values: "USER", "PRO", "SUPER_ADMIN" (enforced by a CHECK constraint; see lib/roles.ts)
  role                String                 @default("USER")
  twoFactorSecret     String?
  twoFactorEnabled    Boolean                @default(false)
  /// Set when a staff member suspends the account; null means not suspended.
  suspendedAt         DateTime?
  /// Last successful sign-in; approximates activity until finer tracking exists.
  lastActiveAt        DateTime?
  /// ISO 3166-1 alpha-2 country code captured from request geo headers at signup.
  country             String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  accounts            Account[]
  analytics           Analytics[]
  backupCodes         TwoFactorBackupCode[]
  customThemes        CustomTheme[]
  emailVerification   EmailVerification?
  links               Link[]
  loginEvents         LoginEvent[]
  passwordResetTokens PasswordResetToken[]
  profile             Profile?
  sessions            Session[]
  subscription        Subscription?
}

/** General-purpose metrics table — every metric (current and future) is a row keyed by
 *  (userId, date, metric, dimension). "dimension" defaults to "total" (no breakdown);
 *  future metrics can write dimensioned rows (referrer, device, linkId, ...) without a migration. */
model Analytics {
  userId    String
  date      DateTime @db.Date
  metric    String
  dimension String   @default("total")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date, metric, dimension])
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  paystackCustomerId     String?   @unique
  paystackSubscriptionId String?   @unique
  paystackPlanCode       String?
  authorizationCode      String?
  cardLast4              String?
  cardBrand              String?
  cardExpiry             String?
  planId                 String    @default("free")
  status                 String    @default("active")
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** Immutable log of staff actions taken in the admin portal. Deliberately has no
 *  relation to User so entries survive account deletion. */
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorEmail   String?
  /// e.g. "user.suspend", "user.delete", "user.changePlan", "user.sendReset"
  action       String
  targetUserId String?
  targetEmail  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

/** One row per successful sign-in (any provider). Powers the admin Security tab's
 *  recent-logins list; ip/country/userAgent are best-effort from request headers. */
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  country   String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Link {
  id           String   @id @default(cuid())
  title        String
  url          String
  icon         String?
  clicks       Int      @default(0)
  status       Int      @default(0)
  order        Int      @default(0)
  thumbnailUrl String?
  thumbnailKey String?
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickDays    ClickDaily[]

  @@index([userId])
}

model ClickDaily {
  id        String   @id @default(cuid())
  linkId    String
  userId    String
  day       DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, day])
  @@index([userId, day])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  handle           String?  @unique
  displayName      String?
  hasClaimedHandle Boolean  @default(false)
  bio              String?
  layout           String   @default("classic")
  themeId          String   @default("default")
  accentColor      String?
  buttonStyle      String?
  fontFamily       String?
  avatarUrl        String?
  avatarKey        String?
  backgroundType   String   @default("gradient")
  backgroundValue  String   @default("midnight")
  backgroundKey    String?
  effects          String   @default("")
  textColor        String?
  cardStyle        String   @default("filled")
  bodyFont         String   @default("Geist")
  overlayColor     String   @default("#000000")
  overlayOpacity   Int      @default(0)
  linkDensity      String   @default("default")
  customThemeName     String   @default("My Theme") @db.VarChar(60)
  activeCustomThemeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomTheme {
  id              String   @id @default(cuid())
  userId          String
  name            String   @default("My Theme") @db.VarChar(60)
  themeId         String   @default("default")
  accentColor     String   @default("#3b46e0")
  buttonStyle     String   @default("rounded")
  fontFamily      String   @default("Instrument Serif")
  backgroundType  String   @default("gradient")
  backgroundValue String   @default("midnight")
  backgroundKey   String?
  effects         String   @default("")
  textColor       String?
  cardStyle       String   @default("filled")
  bodyFont        String   @default("Geist")
  overlayColor    String   @default("#000000")
  overlayOpacity  Int      @default(0)
  profileLayout   String   @default("classic")
  linkDensity     String   @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
